# Doppler Configuration
# Set DOPPLER_ENABLED=true to use Doppler for secrets management
DOPPLER_ENABLED=false
DOPPLER_TOKEN=your-doppler-service-token-here
DOPPLER_PROJECT=your-project-name
DOPPLER_CONFIG=dev

# Standard Environment Variables (used when Doppler is disabled)
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Logging
LOG_LEVEL=info
